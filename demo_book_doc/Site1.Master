            <asp:ContentPlaceHolder ID="ContentPlaceHolder2" runat="server">
                 <main>
        <!-- Hero Section -->
        <section class="hero-section py-5">
            <div class="container">
                <div class="row align-items-center g-5">
                    <div class="col-lg-7" data-aos="fade-right">
                        <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-2 mb-3">Trusted Online Doctor Booking</span>
                        <h1 class="display-5 fw-bold mb-3">Book appointments with top doctors in minutes.</h1>
                        <p class="lead text-muted mb-4">Modern, secure, and simple digital healthcare booking for patients, doctors, and administrators.</p>
                        <div class="d-flex flex-wrap gap-3">
                            <a href="doctor-search.html" class="btn btn-primary btn-lg rounded-pill px-4">Search Doctor</a>
                            <a href="about.html" class="btn btn-outline-primary btn-lg rounded-pill px-4">Learn More</a>
                        </div>
                    </div>
                    <div class="col-lg-5" data-aos="fade-left">
                        <div class="hero-card p-4 rounded-4 shadow-lg">
                            <img src="https://images.unsplash.com/photo-1576091160550-2173dba999ef?auto=format&fit=crop&w=900&q=80" class="img-fluid rounded-4" alt="Doctor Consultation">
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- About Section -->
        <section class="py-5 bg-white">
            <div class="container">
                <div class="row align-items-center g-5">
                    <div class="col-lg-6" data-aos="fade-up">
                        <img src="https://images.unsplash.com/photo-1537368910025-700350fe46c7?auto=format&fit=crop&w=900&q=80" class="img-fluid rounded-4 shadow" alt="Medical Team">
                    </div>
                    <div class="col-lg-6" data-aos="fade-up" data-aos-delay="100">
                        <h2 class="fw-bold mb-3">Why patients choose CareConnect</h2>
                        <p class="text-muted">We provide a fast and elegant online platform for scheduling consultations with experienced doctors across multiple specialties.</p>
                        <ul class="list-unstyled mt-4">
                            <li class="mb-3"><i class="bi bi-check-circle-fill text-success me-2"></i>Verified doctors and hospitals</li>
                            <li class="mb-3"><i class="bi bi-check-circle-fill text-success me-2"></i>Easy appointment booking</li>
                            <li class="mb-3"><i class="bi bi-check-circle-fill text-success me-2"></i>Fast response and digital records</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- Top Doctors -->
        <section class="py-5 bg-light">
            <div class="container">
                <div class="section-heading text-center mb-5" data-aos="fade-up">
                    <h2 class="fw-bold">Top Doctors</h2>
                    <p class="text-muted">Meet our highly rated specialists.</p>
                </div>
                <div class="row g-4">
                    <div class="col-md-6 col-lg-3" data-aos="fade-up">
                        <div class="card h-100 border-0 shadow-sm rounded-4">
                            <img src="https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?auto=format&fit=crop&w=600&q=80" class="card-img-top rounded-top-4" alt="Doctor">
                            <div class="card-body">
                                <h5 class="card-title">Dr. Sarah Khan</h5>
                                <p class="text-primary mb-1">Cardiologist</p>
                                <p class="text-muted small">Apollo Hospital, Karachi</p>
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <span class="badge bg-success-subtle text-success">4.9 ★</span>
                                    <a href="doctor-profile.html" class="btn btn-sm btn-outline-primary rounded-pill">View</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="100">
                        <div class="card h-100 border-0 shadow-sm rounded-4">
                            <img src="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=600&q=80" class="card-img-top rounded-top-4" alt="Doctor">
                            <div class="card-body">
                                <h5 class="card-title">Dr. Ali Hassan</h5>
                                <p class="text-primary mb-1">Dermatologist</p>
                                <p class="text-muted small">Lifecare Hospital, Lahore</p>
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <span class="badge bg-success-subtle text-success">4.8 ★</span>
                                    <a href="doctor-profile.html" class="btn btn-sm btn-outline-primary rounded-pill">View</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="200">
                        <div class="card h-100 border-0 shadow-sm rounded-4">
                            <img src="https://images.unsplash.com/photo-1594824476967-48c8b964273f?auto=format&fit=crop&w=600&q=80" class="card-img-top rounded-top-4" alt="Doctor">
                            <div class="card-body">
                                <h5 class="card-title">Dr. Ayesha Noor</h5>
                                <p class="text-primary mb-1">Neurologist</p>
                                <p class="text-muted small">MediPlus, Islamabad</p>
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <span class="badge bg-success-subtle text-success">4.7 ★</span>
                                    <a href="doctor-profile.html" class="btn btn-sm btn-outline-primary rounded-pill">View</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="300">
                        <div class="card h-100 border-0 shadow-sm rounded-4">
                            <img src="https://images.unsplash.com/photo-1584515933487-779824d29309?auto=format&fit=crop&w=600&q=80" class="card-img-top rounded-top-4" alt="Doctor">
                            <div class="card-body">
                                <h5 class="card-title">Dr. Usman Raza</h5>
                                <p class="text-primary mb-1">Orthopedic</p>
                                <p class="text-muted small">City Care Hospital</p>
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <span class="badge bg-success-subtle text-success">4.9 ★</span>
                                    <a href="doctor-profile.html" class="btn btn-sm btn-outline-primary rounded-pill">View</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Specializations -->
        <section class="py-5">
            <div class="container">
                <div class="section-heading text-center mb-5" data-aos="fade-up">
                    <h2 class="fw-bold">Specializations</h2>
                    <p class="text-muted">Choose from a variety of expert departments.</p>
                </div>
                <div class="row g-4">
                    <div class="col-sm-6 col-lg-3" data-aos="fade-up">
                        <div class="card text-center border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body">
                                <i class="bi bi-heart-pulse display-5 text-primary"></i>
                                <h5 class="mt-3">Cardiology</h5>
                                <p class="text-muted small">Heart and vascular care</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3" data-aos="fade-up" data-aos-delay="100">
                        <div class="card text-center border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body">
                                <i class="bi bi-lungs display-5 text-primary"></i>
                                <h5 class="mt-3">Pulmonology</h5>
                                <p class="text-muted small">Respiratory expert care</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3" data-aos="fade-up" data-aos-delay="200">
                        <div class="card text-center border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body">
                                <i class="bi bi-bandaid display-5 text-primary"></i>
                                <h5 class="mt-3">Dermatology</h5>
                                <p class="text-muted small">Skin and hair treatment</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3" data-aos="fade-up" data-aos-delay="300">
                        <div class="card text-center border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body">
                                <i class="bi bi-brain display-5 text-primary"></i>
                                <h5 class="mt-3">Neurology</h5>
                                <p class="text-muted small">Brain and nervous system</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- How It Works -->
        <section class="py-5 bg-light">
            <div class="container">
                <div class="section-heading text-center mb-5" data-aos="fade-up">
                    <h2 class="fw-bold">How it Works</h2>
                    <p class="text-muted">A simple three-step process to get care.</p>
                </div>
                <div class="row g-4">
                    <div class="col-md-4" data-aos="fade-up">
                        <div class="card border-0 shadow-sm rounded-4 h-100 text-center p-4">
                            <div class="icon-box bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3">1</div>
                            <h5>Search Doctor</h5>
                            <p class="text-muted">Find doctors by specialization, city, fee, and experience.</p>
                        </div>
                    </div>
                    <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
                        <div class="card border-0 shadow-sm rounded-4 h-100 text-center p-4">
                            <div class="icon-box bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3">2</div>
                            <h5>Book Appointment</h5>
                            <p class="text-muted">Select a convenient slot and provide patient details.</p>
                        </div>
                    </div>
                    <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
                        <div class="card border-0 shadow-sm rounded-4 h-100 text-center p-4">
                            <div class="icon-box bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3">3</div>
                            <h5>Make Payment</h5>
                            <p class="text-muted">Complete the secure payment and receive your confirmation.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Testimonials -->
        <section class="py-5">
            <div class="container">
                <div class="section-heading text-center mb-5" data-aos="fade-up">
                    <h2 class="fw-bold">Patient Testimonials</h2>
                    <p class="text-muted">What patients say about us.</p>
                </div>
                <div class="row g-4">
                    <div class="col-md-4" data-aos="fade-up">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body">
                                <p class="text-muted">“The booking experience was smooth and professional. I booked my consultation in minutes.”</p>
                                <div class="d-flex align-items-center mt-3">
                                    <i class="bi bi-person-circle fs-3 text-primary me-2"></i>
                                    <div>
                                        <h6 class="mb-0">Rimsha Q.</h6>
                                        <small class="text-muted">Patient</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body">
                                <p class="text-muted">“Very clean interface and easy navigation. I loved the doctor profiles.”</p>
                                <div class="d-flex align-items-center mt-3">
                                    <i class="bi bi-person-circle fs-3 text-primary me-2"></i>
                                    <div>
                                        <h6 class="mb-0">Hammad S.</h6>
                                        <small class="text-muted">Patient</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body">
                                <p class="text-muted">“The platform helps our clinic manage appointments professionally.”</p>
                                <div class="d-flex align-items-center mt-3">
                                    <i class="bi bi-person-circle fs-3 text-primary me-2"></i>
                                    <div>
                                        <h6 class="mb-0">Dr. Mehwish A.</h6>
                                        <small class="text-muted">Doctor</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Counters -->
        <section class="py-5 bg-primary text-white">
            <div class="container">
                <div class="row text-center g-4">
                    <div class="col-md-3" data-aos="zoom-in">
                        <h2 class="fw-bold">250+</h2>
                        <p>Doctors</p>
                    </div>
                    <div class="col-md-3" data-aos="zoom-in" data-aos-delay="100">
                        <h2 class="fw-bold">12k+</h2>
                        <p>Patients</p>
                    </div>
                    <div class="col-md-3" data-aos="zoom-in" data-aos-delay="200">
                        <h2 class="fw-bold">96%</h2>
                        <p>Satisfaction</p>
                    </div>
                    <div class="col-md-3" data-aos="zoom-in" data-aos-delay="300">
                        <h2 class="fw-bold">24/7</h2>
                        <p>Support</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ -->
        <section class="py-5">
            <div class="container">
                <div class="section-heading text-center mb-5" data-aos="fade-up">
                    <h2 class="fw-bold">Frequently Asked Questions</h2>
                    <p class="text-muted">Need help? Here are answers to common questions.</p>
                </div>
                <div class="accordion" id="faqAccordion">
                    <div class="accordion-item rounded-4 overflow-hidden mb-3" data-aos="fade-up">
                        <h2 class="accordion-header"><button class="accordion-button" data-bs-toggle="collapse" data-bs-target="#faqOne">How do I book an appointment?</button></h2>
                        <div id="faqOne" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">Search for a doctor, open their profile, and choose a time slot on the booking page.</div>
                        </div>
                    </div>
                    <div class="accordion-item rounded-4 overflow-hidden mb-3" data-aos="fade-up" data-aos-delay="100">
                        <h2 class="accordion-header"><button class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#faqTwo">Can I cancel or reschedule?</button></h2>
                        <div id="faqTwo" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">Yes, you can manage upcoming appointments from the history page.</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Newsletter -->
        <section class="py-5 bg-light">
            <div class="container">
                <div class="row align-items-center g-4" data-aos="fade-up">
                    <div class="col-lg-8">
                        <h3 class="fw-bold mb-2">Get the latest health tips directly in your inbox.</h3>
                        <p class="text-muted mb-0">Subscribe for wellness updates and appointment reminders.</p>
                    </div>
                    <div class="col-lg-4">
                        <form class="d-flex gap-2">
                            <input type="email" id="txtNewsletterEmail" name="NewsletterEmail" class="form-control" placeholder="Enter your email" required>
                            <button type="button" class="btn btn-primary">Join</button>
                        </form>
                    </div>
                </div>
            </div>
        </section>
    </main>
</asp:ContentPlaceHolder>
